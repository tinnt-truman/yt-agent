# Copy this file to .env and fill in your own values. Never commit .env.

PORT=8080

# postgres://user:password@host:port/dbname?sslmode=disable
DATABASE_URL=postgres://ytagent:ytagent@localhost:5432/ytagent?sslmode=disable

# Shared password protecting every /api/* route (except /api/auth/login and
# /healthz) — this app has no user accounts, just one operator. REQUIRED once
# deployed publicly (e.g. on Vercel); leave blank only for local dev, which
# then runs fully open with no login prompt.
APP_PASSWORD=

# Comma-separated list of allowed origins for CORS, e.g. your deployed
# frontend's URL(s) — a project on Vercel can be reached from more than one
# domain (production alias, the *.vercel.app project domain, per-preview
# URLs), so list every one you expect requests from.
# Leave blank to allow any origin — fine for local dev, and fine in
# production too since this API has no cookie/session auth to protect.
CORS_ORIGIN=

# Optional. These only SEED the settings table on first boot — after that,
# manage keys and model from the app's /config page instead. Safe to leave
# blank and configure everything in the UI.
# Create at https://console.cloud.google.com/ -> APIs & Services -> Credentials
# Enable "YouTube Data API v3" for the project first.
YOUTUBE_API_KEY=

# Create at https://platform.deepseek.com/ (API Keys section)
DEEPSEEK_API_KEY=

# OpenCode Zen key for the free models (big-pickle, mimo-v2.5-free,
# ling-3.0-flash-fin-free, nemotron-3-ultra-free, nemotron-3.5-lightning-free,
# muse-spark-1.2/1.3-contributor-free). Sign in at https://opencode.ai/auth,
# copy the key, then pick provider + model on the app's /config page.
# NOTE: free models may train on your prompts — don't send sensitive data.
OPENCODE_API_KEY=

# Which AI backend to use by default on first boot: deepseek or zen.
AI_PROVIDER=deepseek
AI_MODEL=deepseek-v4-pro
MAX_VIDEOS=50

# Optional — only needed for "Kênh của tôi" (connect a real YouTube channel
# via Google to see private Analytics: watch time, revenue, monetization
# status). Leave all four blank to skip that feature entirely; everything
# else in the app works without it.
#
# 1. console.cloud.google.com -> APIs & Services -> Library -> enable
#    "YouTube Data API v3" and "YouTube Analytics API".
# 2. APIs & Services -> OAuth consent screen -> External, add your own
#    Google account under "Test users" (keeps it in Testing mode — no
#    Google verification needed for personal/single-operator use).
# 3. APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
#    -> Web application. Add an Authorized redirect URI that exactly matches
#    GOOGLE_OAUTH_REDIRECT_URL below (add both a localhost one for dev and
#    your deployed backend URL for production — one client can list several).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the OAuth client above.
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/oauth/google/callback
# Where the browser is sent after the Google consent flow completes.
FRONTEND_URL=http://localhost:5173
